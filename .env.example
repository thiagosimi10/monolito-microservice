# PostgreSQL
POSTGRES_DB=monolith
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend -> database connection (SQLAlchemy 2 + psycopg 3 driver).
# Host is "postgres" (the compose service name) when running via docker compose.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/monolith

# Comma-separated list of origins allowed by the API's CORS middleware.
CORS_ORIGINS=http://localhost:5173

# Base URL the Vue app uses to reach the backend from the browser.
VITE_API_URL=http://localhost:8000
